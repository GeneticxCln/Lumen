{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-read",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/extractor", "sidecar": true },
        { "name": "mpv", "args": true }
      ]
    }
  ]
}
