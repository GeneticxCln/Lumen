{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumen",
  "version": "0.1.13",
  "identifier": "com.quinton.lumen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen — Your media. Your rules.",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v"
        ],
        "mimeType": "video/mp4",
        "name": "Video",
        "role": "Viewer"
      },
      {
        "ext": [
          "mkv"
        ],
        "mimeType": "video/x-matroska",
        "name": "Matroska video",
        "role": "Viewer"
      },
      {
        "ext": [
          "webm"
        ],
        "mimeType": "video/webm",
        "name": "WebM video",
        "role": "Viewer"
      },
      {
        "ext": [
          "avi"
        ],
        "mimeType": "video/x-msvideo",
        "name": "AVI video",
        "role": "Viewer"
      },
      {
        "ext": [
          "mov"
        ],
        "mimeType": "video/quicktime",
        "name": "QuickTime video",
        "role": "Viewer"
      },
      {
        "ext": [
          "ts",
          "m2ts"
        ],
        "mimeType": "video/mp2t",
        "name": "MPEG transport stream",
        "role": "Viewer"
      },
      {
        "ext": [
          "mpg",
          "mpeg"
        ],
        "mimeType": "video/mpeg",
        "name": "MPEG video",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogv"
        ],
        "mimeType": "video/ogg",
        "name": "Ogg video",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3"
        ],
        "mimeType": "audio/mpeg",
        "name": "MP3 audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "flac"
        ],
        "mimeType": "audio/flac",
        "name": "FLAC audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav"
        ],
        "mimeType": "audio/x-wav",
        "name": "WAV audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogg",
          "opus"
        ],
        "mimeType": "audio/ogg",
        "name": "Ogg audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a",
          "aac"
        ],
        "mimeType": "audio/mp4",
        "name": "AAC audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u8"
        ],
        "mimeType": "application/vnd.apple.mpegurl",
        "name": "HLS playlist",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u"
        ],
        "mimeType": "audio/x-mpegurl",
        "name": "M3U playlist",
        "role": "Viewer"
      }
    ],
    "category": "Video",
    "shortDescription": "Media library and player",
    "linux": {
      "deb": {
        "depends": [
          "mpv"
        ],
        "recommends": [
          "ffmpeg"
        ],
        "desktopTemplate": "linux/lumen.desktop"
      },
      "rpm": {
        "depends": [
          "mpv"
        ],
        "recommends": [
          "ffmpeg"
        ],
        "desktopTemplate": "linux/lumen.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lumen"
        ]
      }
    }
  }
}
